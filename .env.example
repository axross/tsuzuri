# Server- and edge-side Sentry DSN. Leave unset to keep error tracking
# inert: no error, no warning, no network attempt.
SENTRY_DSN=

# Browser-side Sentry DSN. Must carry the NEXT_PUBLIC_ prefix to reach the
# client bundle (read directly in instrumentation-client.ts, not through
# src/shared/lib/env.ts); leave unset for the same inert behavior as
# SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Pino root logger level (debug | info | warn | error). Defaults to "info"
# when unset.
LOG_LEVEL=
