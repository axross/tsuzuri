{
  "PROJECT_NAME": "tsuzuri",
  "PROJECT_OVERVIEW": "A web application that treats a GitHub repository a user has linked to it as the blog's backend, formatting and serving the posts, media, and metadata it holds.",
  "PROJECT_KIND": "web app",
  "PRIMARY_LANGUAGE": "TypeScript",
  "APP_FRAMEWORK": "Next.js",
  "PACKAGE_MANAGER": "npm",
  "LINTER": "Biome",
  "FORMATTER": "Biome",
  "UNIT_TEST_FRAMEWORK": "Vitest",
  "E2E_TEST_FRAMEWORK": "Playwright",
  "CMS_OR_DATA_LAYER": "the linked GitHub repository, read and written through the GitHub API",
  "HOSTING_PLATFORM": "Vercel",
  "INSTALL_CMD": "npm install",
  "DEV_CMD": "npm run dev",
  "BUILD_CMD": "npm run build",
  "START_CMD": "npm run start",
  "FORMAT_CMD": "npm run format",
  "LINT_CMD": "npm run lint",
  "TYPECHECK_CMD": "npm run typecheck",
  "UNIT_TEST_CMD": "npm run test:unit",
  "E2E_TEST_CMD": "npm run test:e2e",
  "CODE_FILE_GLOB": "*.ts | *.tsx | *.js | *.jsx | *.css | *.json",
  "CODE_FILE_REGEX": "\\.(ts|tsx|js|jsx|css|json)$"
}
