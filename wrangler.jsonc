{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tsuzuri",
	// `worker.ts`, not `.open-next/worker.js` directly: it wraps the OpenNext
	// handler in `@sentry/cloudflare`'s `withSentry`. See the file itself.
	"main": "worker.ts",
	// 2025-08-16 or later, per Sentry's own "Next.js on Cloudflare" guide: it
	// is when `https.request` — which the SDK's transport uses — reached the
	// Workers runtime, which is a later floor than OpenNext's own.
	"compatibility_date": "2025-08-16",
	// Required by both @opennextjs/cloudflare and @sentry/cloudflare.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Read by @sentry/cloudflare's getFinalOptions
	// (node_modules/@sentry/cloudflare/build/esm/options.js) as
	// env.CF_VERSION_METADATA.id, and used to fill `release` on every
	// Sentry event when worker.ts's options callback does not set one
	// itself — see worker.ts. Confirmed a supported binding key at the
	// pinned wrangler 4.125.0 (config-schema.json's `version_metadata`
	// property: `{ binding: string }`).
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	}
}
