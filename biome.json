{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**",
			"e2e/**",
			"messages/**",
			"next.config.ts",
			"next-env.d.ts",
			"instrumentation-client.ts",
			"vitest.config.ts",
			"playwright.config.ts",
			"tsconfig.json",
			"package.json",
			"biome.json",
			"worker.ts",
			"open-next.config.ts",
			"wrangler.jsonc"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
